# ---------------------------------------------------------------------------
# Local development environment. GITIGNORED — never commit this file.
# Copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service-role key: Supabase dashboard -> Project Settings -> API Keys.
# This bypasses row-level security. Server-side only — never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for photos and audio.
SUPABASE_STORAGE_BUCKET=recon-media

# Postgres connection string.
#
# USE PORT 6543 (transaction mode) FOR VERCEL SERVERLESS.
#   Supabase dashboard -> Project Settings -> Database -> Connection string
#
#   Transaction (recommended for serverless) : host:6543  user=postgres.<ref>
#   Session  (NOT recommended — holds one PG connection per client)
#                                          : host:5432
#
# 5432 will exhaust your connection limit under concurrent serverless
# functions. Use 6543 unless you have a specific reason not to.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# One-time token that authorises the initial passcode + anchor-date setup
# via POST /api/auth-bootstrap. Generate the same way as SESSION_SECRET.
# After bootstrap you can clear this from Vercel.
APP_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Vercel project settings (set these in the dashboard, not here)
# ---------------------------------------------------------------------------
# Build command:     npm run build:css
# Output directory:  (leave blank — static files are served from the repo root)
# PHP runtime:       vercel-php@0.9.0   (set in vercel.json)
#
# Cron (keeps the free-tier database from pausing after 7 idle days):
#   0 6 * * *   ->   /api/health
#
# Note: Vercel builds the Tailwind CSS via buildCommand, so `css/app.css`
# is gitignored and never committed.