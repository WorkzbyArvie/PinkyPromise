{
  "name": "reconciliation-memory-box",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive relationship & reconciliation web app — memory photocards, anniversary calendar, heart decks.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/app.css --minify",
    "dev:css": "tailwindcss -i ./src/input.css -o ./css/app.css --watch",
    "serve:css": "tailwindcss -i ./src/input.css -o ./css/app.css",
    "serve": "serve -l 4173 .",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "db:status": "node scripts/status.mjs",
    "db:verify": "node scripts/verify-rls.mjs",
    "db:reset-passcode": "node scripts/reset-passcode.mjs",
    "test": "node test.mjs && node test-sources.mjs",
    "test:api": "node scripts/test-api.mjs",
    "lint:php": "for /f %f in ('dir /b /s api\\*.php lib\\*.php') do @php -l %f"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.0"
  }
}
