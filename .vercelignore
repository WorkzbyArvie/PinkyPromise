# ---------------------------------------------------------------------------
# Uploaded to Vercel as part of the source tree.
# Everything here MUST exist at runtime, so be careful what you exclude.
#
# NOTE: the vercel-php runtime does NOT support `includeFiles` — it ships the
# whole project tree. PHP helpers therefore live in /lib, NOT /api, because
# every .php under /api is compiled into its own serverless function.
# ---------------------------------------------------------------------------

# Never upload secrets
.env
.env.*
!.env.example

# Build tooling — nothing here runs on Vercel, and there is no build step.
# (Tailwind runs locally; css/app.css is committed.)
node_modules/

# Git / editor
.git/
.gitignore
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db

# Local-only files
router.php

# Design docs (not needed by the runtime)
DESIGN-SYSTEM.md
design-system/

# Dev-only Node tooling. Uses the `pg` devDependency and is never executed
# by a PHP function, so there is no reason to ship it.
scripts/